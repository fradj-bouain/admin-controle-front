server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Sert uniquement les fichiers statiques Angular. L'API est appelée
    # directement par le navigateur sur l'URL publique du backend (voir
    # environment.prod.ts) — pas de proxy /api/ ici : après plusieurs essais,
    # ni le réseau privé Railway (DNS non résolvable depuis ce conteneur) ni
    # le proxy vers l'URL publique du backend (401 vide, cause non identifiée
    # spécifique au trafic sortant d'un conteneur Railway) ne se sont montrés
    # fiables. Le CORS backend est configuré pour autoriser cette origine.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
