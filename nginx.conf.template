server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # DNS publics (Google/Cloudflare) : on a constaté que la résolution DNS
    # privée Railway (admin-controle.railway.internal) n'est pas fiable
    # depuis ce conteneur (resolver 127.0.0.11 : connexion refusée). On
    # proxifie donc vers l'URL PUBLIQUE du backend, qui elle est résolue
    # par le DNS public normal.
    resolver 8.8.8.8 1.1.1.1 valid=30s;

    # SPA : toute route inconnue retombe sur index.html (routing Angular en mode PathLocationStrategy)
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # Variable (pas un hôte littéral) pour forcer une résolution DNS
        # dynamique à chaque requête plutôt qu'une seule fois au démarrage.
        set $backend_upstream "${BACKEND_PUBLIC_HOST}";
        proxy_pass https://$backend_upstream/api/;
        proxy_ssl_server_name on;
        # Host = domaine public du backend (et non $host, qui serait celui
        # du frontend) : l'edge Railway route par nom de domaine (SNI/Host).
        proxy_set_header Host $backend_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
    }
}
