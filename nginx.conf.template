server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # DNS embarqué de Docker (adresse standard sur les runtimes basés Docker,
    # dont Railway) : nécessaire pour que la résolution de l'hôte interne
    # Railway ci-dessous soit faite à CHAQUE requête plutôt qu'une seule fois
    # au démarrage de nginx (sinon un DNS pas encore prêt au boot, ou une IP
    # de conteneur qui change, laisse le proxy bloqué indéfiniment -> 504).
    resolver 127.0.0.11 ipv6=off valid=10s;

    # SPA : toute route inconnue retombe sur index.html (routing Angular en mode PathLocationStrategy)
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # L'utilisation d'une variable ($backend_upstream) plutôt qu'un hôte
        # littéral dans proxy_pass force nginx à résoudre le DNS à chaque
        # requête via le resolver ci-dessus, au lieu de le mettre en cache
        # une seule fois au démarrage.
        set $backend_upstream "${BACKEND_INTERNAL_HOST}:${BACKEND_INTERNAL_PORT}";
        proxy_pass http://$backend_upstream/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
    }
}
